{
  "name": "aula",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vitrina de la plataforma de cursos de los pubs (prototipo, fase 4).",
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.4.1",
    "cheerio": "1.2.0",
    "js-yaml": "5.5.0",
    "katex": "0.19.0",
    "lucide-static": "1.52.0",
    "sharp": "0.35.5"
  },
  "scripts": {
    "tokens": "node scripts/tokens.mjs --aplicar",
    "build": "node scripts/tokens.mjs --aplicar && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "enlaces": "node scripts/enlaces.mjs",
    "vista:methodica": "ASTRO_TELEMETRY_DISABLED=1 PUB=methodica astro preview --port 4331 --host 127.0.0.1",
    "vista:numerus-scriptum": "ASTRO_TELEMETRY_DISABLED=1 PUB=numerus-scriptum astro preview --port 4332 --host 127.0.0.1"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0"
  }
}
