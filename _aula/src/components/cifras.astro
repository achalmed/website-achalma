---
// Cifras.astro — la banda de cifras de la portada: lo que el pub tiene, contado desde el modelo (nunca a mano).
// Solo cifras mayores que cero, salvo cursos y temas, que dicen de qué tamaño es el currículo aunque falten lecciones.
// Al entrar en pantalla los números suben desde cero una sola vez (≈0,9 s); con prefers-reduced-motion, sin JS o fuera
// de pantalla se ven quietos con su valor real, que es el que está en el HTML. El lector de pantalla lee la frase
// completa de .sr y nunca el número que se anima.
import { datos } from '../lib/datos.mjs';

const { totales } = datos();
const todas = [
  { n: totales.cursos, uno: 'curso', varios: 'cursos', fija: true },
  { n: totales.temas, uno: 'tema del currículo', varios: 'temas del currículo', fija: true },
  { n: totales.lecciones + totales.complementarias, uno: 'lección publicada', varios: 'lecciones publicadas' },
  { n: totales.articulos, uno: 'artículo', varios: 'artículos' },
  { n: totales.ediciones, uno: 'edición dictada', varios: 'ediciones dictadas' },
];
const cifras = todas.filter((c) => c.fija || c.n > 0);
---
<ul class="cifras" aria-label="El pub en cifras" data-cifras>
  {cifras.map((c) => (
    <li class="cifra">
      <span class="numero" aria-hidden="true" data-cifra={c.n} style={`min-width: ${String(c.n).length}ch`}>{c.n}</span>
      <span class="rotulo" aria-hidden="true">{c.n === 1 ? c.uno : c.varios}</span>
      <span class="sr">{c.n} {c.n === 1 ? c.uno : c.varios}</span>
    </li>
  ))}
</ul>

<script>
  const banda = document.querySelector<HTMLElement>('[data-cifras]');
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (banda && !quieto && 'IntersectionObserver' in window) {
    const numeros = [...banda.querySelectorAll<HTMLElement>('[data-cifra]')];
    // Solo se anima si la banda aún no está a la vista: la que ya se ve al cargar no parpadea a cero.
    const r = banda.getBoundingClientRect();
    if (r.top > innerHeight) {
      banda.classList.add('en-espera');
      numeros.forEach((el) => { el.textContent = '0'; });
      const obs = new IntersectionObserver((entradas) => {
        if (!entradas.some((e) => e.isIntersecting)) return;
        obs.disconnect();
        banda.classList.remove('en-espera');
        const inicio = performance.now();
        const paso = (t: number) => {
          const p = Math.min(1, (t - inicio) / 900);
          const suave = 1 - Math.pow(1 - p, 3);
          numeros.forEach((el) => { el.textContent = String(Math.round(Number(el.dataset.cifra) * suave)); });
          if (p < 1) requestAnimationFrame(paso);
        };
        requestAnimationFrame(paso);
      }, { threshold: 0.4 });
      obs.observe(banda);
    }
  }
</script>

<style>
  /* Cifras limpias (autor, 2026-10-21): sin filetes ni caja; el número manda y el rótulo lo acompaña en gris. */
  .cifras {
    list-style: none; display: flex; flex-wrap: wrap; gap: 1.25rem clamp(2rem, 1rem + 4vw, 4.5rem);
    padding-block: 0.5rem; border: 0; background: none;
  }
  .cifra {
    display: grid; align-content: start; gap: 0.35rem;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.6s;
  }
  .numero {
    font-family: var(--f-titulo); font-weight: 500; font-size: clamp(2.25rem, 1.7rem + 1.8vw, 3.25rem); line-height: 1;
    font-variant-numeric: lining-nums tabular-nums; letter-spacing: -0.025em; color: var(--tinta);
  }
  .rotulo { font: 500 0.875rem/1.3 var(--f-interfaz); color: var(--tenue); }
  /* Los números suben escalonados una sola vez. */
  .en-espera .cifra { transform: translateY(0.6rem); opacity: 0; }
  .cifra:nth-child(2) { transition-delay: 60ms; }
  .cifra:nth-child(3) { transition-delay: 120ms; }
  .cifra:nth-child(4) { transition-delay: 180ms; }
  .cifra:nth-child(5) { transition-delay: 240ms; }
  @media (max-width: 420px) {
    .cifras { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem 1.5rem; }
  }
</style>
