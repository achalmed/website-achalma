---
// laboratorio.astro — los modelos del laboratorio (simuladores) asociados a temas de este curso, por catalogo.json o
// por los recursos {tipo: simulador} de su curso.yml. Los que corren en el navegador enlazan a /laboratorio/<id>/;
// los demás se listan con el motivo. Si el curso no tiene ninguno, no se muestra nada (no se inventa contenido).
import Icono from './icono.astro';
interface Props { modelos: any[] }
const { modelos } = Astro.props;
const enLinea = modelos.filter((m) => m.url).length;
---
{modelos.length > 0 && (
  <section aria-labelledby="t-laboratorio" class="laboratorio">
    <h2 id="t-laboratorio">Laboratorio</h2>
    <p class="tenue">{enLinea > 0
      ? 'Modelos del laboratorio computacional asociados a temas del curso. Se mueven los parámetros y el cálculo corre en el navegador, con el mismo código Python del laboratorio.'
      : 'Modelos del laboratorio computacional asociados a temas del curso; por ahora se abren en el laboratorio de escritorio.'}</p>
    <ul>
      {modelos.map((m) => (
        <li>
          <span class="m-tema dato">{m.tema}</span>
          {m.url
            ? <a class="m-titulo" href={m.url}>{m.titulo}<Icono nombre="arrow-right" tamano={14} /></a>
            : <span class="m-titulo">{m.titulo}</span>}
          {m.pregunta && <span class="m-pregunta">{m.pregunta}</span>}
          <span class="m-ref dato">{m.ref}{!m.url && <> · solo en el escritorio</>}</span>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .laboratorio { display: grid; gap: 0.75rem; }
  .laboratorio h2 { font-size: var(--t-3); }
  .laboratorio p { font-size: var(--t-0); }
  ul { list-style: none; display: grid; }
  li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.15rem 0.6rem; padding-block: 0.6rem; border-top: 1px solid var(--linea); }
  .m-tema { color: var(--acento); grid-row: span 3; }
  .m-titulo { font-weight: 600; font-size: var(--t-1); }
  a.m-titulo { text-decoration: none; }
  a.m-titulo :global(svg) { vertical-align: -0.15em; margin-left: 0.25rem; }
  a.m-titulo:hover { text-decoration: underline; }
  .m-pregunta { font-family: var(--f-lectura); font-size: var(--t-1); color: var(--tinta-2); }
  .m-ref { color: var(--tenue); font-size: 0.72rem; }
</style>
