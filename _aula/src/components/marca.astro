---
// Marca.astro — el ícono de un sitio de la familia (src/lib/marca.mjs): squircle con el degradado del acento del
// data-acento más cercano y el monograma en blanco. Decorativo: el nombre del sitio va siempre escrito al lado.
// `sufijo` distingue los id del degradado cuando el mismo ícono aparece dos veces en la página.
import { colocarMonograma, SQUIRCLE } from '../lib/marca.mjs';
import { datos } from '../lib/datos.mjs';

interface Props { sitio?: string; tamano?: number; sufijo?: string; clase?: string }
const { sitio = datos().pub.id, tamano = 32, sufijo = 'a', clase = '' } = Astro.props;
const m = colocarMonograma(sitio);
const id = `m-${sitio}-${sufijo}`;
---
<svg class:list={['logo', clase]} width={tamano} height={tamano} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-a`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="alto" /><stop offset="1" class="bajo" /></linearGradient>
    <linearGradient id={`${id}-b`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="brillo" /><stop offset="0.5" class="brillo-fin" /></linearGradient>
  </defs>
  <path d={SQUIRCLE} fill={`url(#${id}-a)`} />
  <path d={SQUIRCLE} fill={`url(#${id}-b)`} />
  <path d={SQUIRCLE} class="filo" />
  <path d={m.d} transform={m.transform} class="letras" />
</svg>

<style>
  .logo { flex: none; display: block; filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.18)); }
  .alto { stop-color: var(--icono-alto); }
  .bajo { stop-color: var(--icono-bajo); }
  .brillo { stop-color: var(--lab-blanco); stop-opacity: 0.24; }
  .brillo-fin { stop-color: var(--lab-blanco); stop-opacity: 0; }
  .filo { fill: none; stroke: var(--lab-blanco); stroke-opacity: 0.18; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .letras { fill: var(--lab-blanco); }
</style>
