---
// Pie.astro — la firma del pub y «La familia»: los 11 pubs y el hub, cada uno con su ícono, su nombre y su área.
// Los datos salen del modelo (web/_pubs/pubs.yml, docencia/config/areas.yml y config/vitrina.yml); aquí no se escribe
// ningún nombre ni color a mano. Cada sitio lleva su data-acento, así que su ícono toma su color.
import Marca from './marca.astro';
import Icono from './icono.astro';
import { datos } from '../lib/datos.mjs';
const { pub, red } = datos();
const anio = new Date().getFullYear();
---
<footer class="pie">
  <div class="envoltura pie-rejilla">
    <div class="pie-firma">
      <p class="pie-marca">
        <Marca tamano={36} sufijo="pie" />
        <span><b>{pub.nombre}</b><span class="tenue">por {pub.autor.nombre}</span></span>
      </p>
      <p>{pub.descripcion}</p>
      <p class="tenue">
        Textos con licencia <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.es" rel="license noopener">CC BY-SA 4.0</a>.
        <a href={pub.hub.url}>Más sobre el autor</a>.
      </p>
    </div>
    <nav class="familia" aria-labelledby="t-familia">
      <h2 id="t-familia">La familia</h2>
      <ul>
        {red.map((p) => (
          <li data-acento={p.acento} class:list={[p.actual && 'actual']}>
            <a href={p.url} aria-current={p.actual ? 'page' : undefined}>
              <Marca sitio={p.marca} tamano={28} sufijo="fam" />
              <span class="nombre">{p.nombre}</span>
              <span class="area">{p.area}</span>
              {!p.actual && <Icono nombre="arrow-up-right" tamano={14} clase="salida" />}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="envoltura pie-nota">
    <p>© {anio} {pub.autor.nombre}. Plataforma de cursos de los pubs.</p>
  </div>
</footer>

<style>
  .pie { margin-top: 5rem; border-top: 1px solid var(--linea); background: var(--papel-2); font-size: var(--t-1); }
  .pie-rejilla { display: grid; gap: 2.5rem; padding-block: 3rem 2rem; grid-template-columns: 1fr; }
  @media (min-width: 960px) { .pie-rejilla { grid-template-columns: minmax(0, 0.75fr) minmax(0, 2fr); gap: 4.5rem; } }
  .pie-firma { display: grid; gap: 0.75rem; align-content: start; max-width: 40ch; color: var(--tinta-2); }
  .pie-marca { display: flex; align-items: center; gap: 0.75rem; color: var(--tinta); }
  .pie-marca > span { display: grid; line-height: 1.25; }
  .pie-marca b { font-weight: 650; letter-spacing: -0.015em; }
  .pie-marca .tenue { font-size: var(--t-0); }

  .familia h2 { font-size: var(--t-0); font-weight: 600; color: var(--tenue); letter-spacing: 0; margin-bottom: 0.85rem; }
  .familia ul { list-style: none; display: grid; gap: 0.25rem 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); }
  .familia a {
    position: relative; display: grid; grid-template-columns: 1.75rem 1fr; grid-template-rows: auto auto; column-gap: 0.7rem; align-items: center;
    padding: 0.45rem 1.6rem 0.45rem 0.45rem; border-radius: var(--r-2); text-decoration: none; color: var(--tinta);
    transition: background-color 0.15s;
  }
  .familia a > :global(.logo) { grid-row: span 2; }
  .familia a:hover { background: color-mix(in oklab, var(--tinta) 5%, transparent); }
  .nombre { font-weight: 550; font-size: var(--t-1); line-height: 1.2; align-self: end; }
  .area { font-size: var(--t-0); color: var(--tenue); line-height: 1.3; align-self: start; }
  .familia :global(.salida) { position: absolute; right: 0.5rem; top: 0.6rem; color: var(--tenue); opacity: 0; transition: opacity 0.15s; }
  .familia a:hover :global(.salida), .familia a:focus-visible :global(.salida) { opacity: 1; }
  @media (max-width: 560px) { .familia ul { grid-template-columns: 1fr 1fr; } .area { display: none; } .nombre { align-self: center; font-size: var(--t-0); } .familia a > :global(.logo) { grid-row: auto; } }
  .actual a { background: var(--elevado); box-shadow: var(--sombra); }
  .pie-nota { padding-block: 1.1rem 2rem; color: var(--tenue); font-size: var(--t-0); border-top: 1px solid var(--linea); }
</style>
