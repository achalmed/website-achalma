---
// TarjetaEntrada.astro — un artículo del blog o una lección en una tarjeta: su miniatura (src/lib/imagenes.mjs) o, si
// no tiene imagen propia, el índice del texto (sus primeras secciones) sobre una superficie lisa con el ícono del pub;
// fecha, título, resumen y tiempo de lectura.
// La imagen es decorativa (alt vacío): el título, que es el enlace, ya dice qué es. Toda la tarjeta es clicable.
import Marca from './marca.astro';
import { fechaLarga } from '../lib/datos.mjs';

interface Props { entrada: any; nivel?: 'h2' | 'h3' | 'h4'; leccion?: string | null }
const { entrada: a, nivel = 'h3', leccion = null } = Astro.props;
const H = nivel;
// Sin imagen propia, la tarjeta muestra el esqueleto del texto (sus primeras secciones): cada tarjeta se distingue sin
// inventar una ilustración.
const esqueleto = a.imagen ? [] : (a.indice ?? []).filter((h) => h.nivel === 2).slice(0, 4);
---
<article class="te">
  <div class="te-imagen">
    {a.imagen ? (
      <img src={a.imagen.url} width={a.imagen.ancho} height={a.imagen.alto} alt="" loading="lazy" decoding="async" />
    ) : (
      <div class="te-sin" aria-hidden="true">
        <Marca tamano={esqueleto.length ? 26 : 44} sufijo={`te-${a.slug}`} clase={esqueleto.length ? 'te-marca' : 'te-marca sola'} />
        {esqueleto.length > 0 && (
          <ol class="te-esqueleto">
            {esqueleto.map((h, i) => <li><span class="dato">{h.numero || i + 1}</span>{h.texto}</li>)}
          </ol>
        )}
      </div>
    )}
  </div>
  <div class="te-cuerpo">
    <p class="te-meta">
      <time class="dato" datetime={a.fecha}>{a.fecha}</time>
      <span>{a.minutos} min de lectura</span>
    </p>
    <H class="te-titulo"><a href={a.url} data-leccion={leccion ?? undefined}>{a.titulo}</a></H>
    {a.descripcion && <p class="te-desc">{a.descripcion}</p>}
    {a.categorias?.length > 0 && <p class="te-cat">{a.categorias.slice(0, 3).join(', ')}</p>}
    <span class="sr">Publicado el {fechaLarga(a.fecha)}</span>
  </div>
</article>

<style>
  .te {
    position: relative; display: flex; flex-direction: column; min-width: 0; overflow: hidden;
    background: var(--elevado); border: 1px solid var(--linea); border-radius: var(--r-3); box-shadow: var(--sombra);
    transition: transform 0.2s ease-out, box-shadow 0.2s, border-color 0.2s;
  }
  .te:hover { transform: translateY(-2px); box-shadow: var(--sombra-capa); border-color: var(--linea-fuerte); }
  .te:focus-within { border-color: var(--acento-linea); }
  .te-imagen { aspect-ratio: 16 / 10; background: var(--papel-2); border-bottom: 1px solid var(--linea); overflow: hidden; }
  .te-imagen img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .te-sin { position: relative; width: 100%; height: 100%; overflow: hidden; background: var(--halo), var(--papel-2); }
  .te-sin::before { content: ''; position: absolute; inset: 0; background: var(--puntos); opacity: 0.8; }
  .te-sin :global(.te-marca) { position: absolute; right: 0.9rem; bottom: 0.9rem; opacity: 0.9; }
  .te-sin :global(.te-marca.sola) { right: auto; bottom: auto; left: 50%; top: 50%; transform: translate(-50%, -50%); }
  .te-esqueleto {
    position: absolute; inset: 0.95rem 3.5rem auto 0.95rem; list-style: none; display: grid; gap: 0.32rem;
    font: 500 0.72rem/1.3 var(--f-interfaz); color: var(--tinta-2);
  }
  .te-esqueleto li {
    width: fit-content; max-width: 100%; padding: 0.22rem 0.5rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    background: var(--vidrio); border: 1px solid var(--linea); border-radius: var(--r-1); box-shadow: var(--sombra);
  }
  .te-esqueleto li span { font-family: var(--f-datos); color: var(--acento-tinta); margin-right: 0.45rem; }
  .te-cuerpo { display: grid; gap: 0.45rem; padding: 0.95rem 1.1rem 1.1rem; align-content: start; }
  .te-meta { display: flex; flex-wrap: wrap; gap: 0.2rem 0.9rem; font-size: var(--t-0); color: var(--tenue); }
  .te-meta time { font-family: var(--f-datos); font-size: 0.75rem; }
  .te-titulo { font-size: 1.0625rem; line-height: 1.3; letter-spacing: -0.015em; }
  .te-titulo a { text-decoration: none; color: var(--tinta); }
  .te-titulo a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .te-titulo a:focus-visible { outline: none; }
  .te-titulo a:focus-visible::after { outline: 2px solid var(--acento); outline-offset: 2px; }
  .te:hover .te-titulo a { color: var(--acento-tinta); }
  .te-titulo a:global(.hecha)::before { content: ''; display: inline-block; width: 0.55em; height: 0.55em; background: var(--acento); margin-right: 0.45em; vertical-align: 0.12em; }
  .te-desc { font-size: var(--t-1); color: var(--tinta-2); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .te-cat { font-size: var(--t-0); color: var(--tenue); }
</style>
