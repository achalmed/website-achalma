---
// Blog del pub: artículos que no son lección de ningún tema (destino «blog» en mapa-lecciones.csv).
import Base from '../../layouts/base.astro';
import ListaEntradas from '../../components/lista-entradas.astro';
import { datos, plural } from '../../lib/datos.mjs';
const { pub, blog } = datos();
---
<Base titulo="Blog" descripcion={`Artículos de ${pub.nombre}: ${pub.descripcion}`} seccion="blog">
  <div class="envoltura blog">
    <header class="blog-cabeza">
      <h1>Blog</h1>
      <p>Artículos, guías y notas de {pub.nombre} que no forman parte de un curso. {plural(blog.length, 'entrada publicada', 'entradas publicadas')}.</p>
    </header>
    <ListaEntradas entradas={blog} />
  </div>
</Base>
<style>
  .blog { padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem); max-width: 60rem; }
  .blog-cabeza { display: grid; gap: 0.75rem; margin-bottom: 2rem; }
  .blog-cabeza h1 { font-size: var(--t-5); }
  .blog-cabeza p { color: var(--tinta-2); max-width: 60ch; }
</style>
