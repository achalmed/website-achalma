---
// Portada de un curso: descripción, metadatos, retícula y temario por unidades, progreso del visitante,
// materiales, ediciones (dictados), bibliografía y laboratorio.
import Base from '../../../layouts/Base.astro';
import Reticula from '../../../components/Reticula.astro';
import Laboratorio from '../../../components/Laboratorio.astro';
import { datos, peso, plural } from '../../../lib/datos.mjs';

export function getStaticPaths() {
  return datos().propios.map((curso) => ({ params: { curso: curso.id }, props: { curso } }));
}
const { curso } = Astro.props;
const ids = curso.lecciones.map((l) => `${curso.id}/${l.slug}`);
const conMateriales = curso.lecciones.filter((l) => l.pdf || l.docx);
const unidadesConLeccion = new Set(curso.unidades.filter((u) => u.temas.some((t) => t.leccion)).map((u) => u.id));
const abrirTodo = unidadesConLeccion.size === 0 && curso.unidades.length <= 8;
---
<Base titulo={curso.titulo} descripcion={curso.descripcion ?? `Curso de ${curso.titulo}.`} seccion="cursos">
  <section class="curso-cabeza milimetrado">
    <div class="envoltura">
      <nav aria-label="Ruta"><ol class="migas"><li><a href="/cursos/">Cursos</a></li><li><span aria-current="page">{curso.titulo}</span></li></ol></nav>
      <div class="cabeza-rejilla">
        <div class="cabeza-texto">
          <h1>{curso.titulo}</h1>
          {curso.descripcion && <p class="curso-desc">{curso.descripcion}</p>}
          <div class="acciones" data-progreso-curso={ids.join(' ')}>
            {curso.primera ? (
              <a class="boton primario" href={curso.primera} data-continuar data-ids={ids.join(' ')} data-urls={curso.lecciones.map((l) => l.url).join(' ')}>Empezar por la primera lección</a>
            ) : (
              <span class="boton" aria-disabled="true">Aún no hay lecciones publicadas</span>
            )}
            {curso.lecciones.length > 0 && (
              <div class="progreso">
                <div class="barra" aria-hidden="true"><span data-progreso-barra></span></div>
                <p data-progreso-texto>Tu avance se guarda en este navegador.</p>
              </div>
            )}
          </div>
        </div>
        <dl class="ficha">
          <div><dt>Tipo</dt><dd>{curso.tipoEtiqueta}</dd></div>
          <div><dt>Nivel</dt><dd>{curso.nivelEtiqueta}</dd></div>
          <div><dt>Estado</dt><dd>{curso.estadoEtiqueta}</dd></div>
          <div><dt>Unidades</dt><dd class="dato">{curso.unidades.length}</dd></div>
          <div><dt>Temas</dt><dd class="dato">{curso.nTemas}</dd></div>
          <div><dt>Lecciones publicadas</dt><dd class="dato">{curso.nPublicadas}{curso.complementarias.length > 0 && <span class="tenue"> + {curso.complementarias.length}</span>}</dd></div>
        </dl>
      </div>
      <div class="reticula-grande">
        <h2 class="sr">El temario en una retícula</h2>
        <Reticula curso={curso} modo="completa" />
      </div>
    </div>
  </section>

  <div class="envoltura curso-cuerpo">
    <section class="temario" aria-labelledby="t-temario">
      <h2 id="t-temario">Temario</h2>
      {curso.unidades.length === 0 ? (
        <p class="tenue">El temario de este curso todavía está en preparación: aún no tiene unidades ni temas.</p>
      ) : (
        <div class="unidades">
          {curso.unidades.map((u) => {
            const conLeccion = u.temas.filter((t) => t.leccion).length;
            return (
              <details open={unidadesConLeccion.has(u.id) || abrirTodo}>
                <summary>
                  <span class="u-n dato">{u.id}</span>
                  <span class="u-t">{u.titulo}</span>
                  <span class="u-c">{conLeccion > 0 ? `${conLeccion} de ${u.temas.length} con lección` : plural(u.temas.length, 'tema', 'temas')}</span>
                </summary>
                <ol class="temas">
                  {u.temas.map((t) => (
                    <li>
                      <span class="t-n dato">{t.id}</span>
                      {t.leccion ? (
                        <a href={t.leccion.url} data-leccion={`${curso.id}/${t.leccion.slug}`}>{t.leccion.titulo}<span class="t-tema">{t.titulo}</span></a>
                      ) : (
                        <span class="t-t">{t.titulo}</span>
                      )}
                      <span class:list={['estado', t.leccion ? 'publicada' : 'preparacion']}>{t.leccion ? 'Publicada' : 'En preparación'}</span>
                    </li>
                  ))}
                </ol>
              </details>
            );
          })}
        </div>
      )}

      {curso.complementarias.length > 0 && (
        <section class="complementarias" aria-labelledby="t-complementarias">
          <h3 id="t-complementarias">Lecturas complementarias</h3>
          <p class="tenue">Publicadas en el pub y asociadas al curso, todavía sin un tema del currículo.</p>
          <ul>
            {curso.complementarias.map((l) => (
              <li><a href={l.url} data-leccion={`${curso.id}/${l.slug}`}>{l.titulo}</a> <span class="tenue">{l.minutos} min</span></li>
            ))}
          </ul>
        </section>
      )}
    </section>

    <aside class="lateral">
      {curso.ediciones.length > 0 && (
        <section aria-labelledby="t-ediciones">
          <h2 id="t-ediciones">Ediciones</h2>
          <ul class="lista-simple">
            {curso.ediciones.map((e) => (
              <li><a href={e.url}>{e.titulo}</a><span class="tenue">{plural(e.nSesiones, 'sesión de este curso', 'sesiones de este curso')}</span></li>
            ))}
          </ul>
        </section>
      )}
      <section aria-labelledby="t-materiales">
        <h2 id="t-materiales">Materiales</h2>
        {conMateriales.length === 0 ? (
          <p class="tenue">Las lecciones de este curso aún no tienen PDF ni DOCX.</p>
        ) : (
          <ul class="lista-simple">
            {conMateriales.map((l) => (
              <li>
                <span>{l.titulo}</span>
                <span class="descargas">
                  {l.pdf && <a href={l.pdf.url}>PDF <span class="tenue">{peso(l.pdf.bytes)}</span></a>}
                  {l.docx && <a href={l.docx.url}>DOCX <span class="tenue">{peso(l.docx.bytes)}</span></a>}
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>
      {curso.bibliografia.length > 0 && (
        <section aria-labelledby="t-biblio">
          <h2 id="t-biblio">Bibliografía</h2>
          <ul class="lista-simple">
            {curso.bibliografia.map((b) => (
              <li><span>{b.titulo}</span><span class="tenue">{b.autor}{b.calibre_id && <>, Calibre <span class="dato">{b.calibre_id}</span></>}</span></li>
            ))}
          </ul>
        </section>
      )}
      <Laboratorio modelos={curso.modelos} />
    </aside>
  </div>
</Base>

<script>
  import { completadas, pintarProgreso } from '../../../scripts/almacen.js';
  pintarProgreso();
  const boton = document.querySelector<HTMLAnchorElement>('[data-continuar]');
  if (boton) {
    const ids = (boton.dataset.ids || '').split(' ');
    const urls = (boton.dataset.urls || '').split(' ');
    const hechas = completadas();
    const n = ids.filter((id) => hechas[id]).length;
    const siguiente = ids.findIndex((id) => !hechas[id]);
    if (n > 0 && siguiente >= 0) { boton.href = urls[siguiente]; boton.textContent = 'Continuar donde lo dejaste'; }
    else if (n > 0 && siguiente < 0) { boton.textContent = 'Repasar desde la primera lección'; }
  }
</script>

<style>
  .curso-cabeza { border-bottom: 1px solid var(--linea); padding-block: 2rem 2.5rem; }
  .cabeza-rejilla { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 960px) { .cabeza-rejilla { grid-template-columns: minmax(0, 1fr) 20rem; gap: 4rem; } }
  .cabeza-texto { display: grid; gap: 1rem; }
  .cabeza-texto h1 { font-size: var(--t-5); }
  .curso-desc { font-family: var(--f-lectura); font-size: 1.2rem; line-height: 1.5; color: var(--tinta-2); max-width: 52ch; }
  .acciones { align-items: center; margin-top: 0.5rem; }
  .progreso { display: grid; gap: 0.35rem; min-width: 12rem; flex: 1; max-width: 22rem; }
  .progreso p { font-size: var(--t-0); color: var(--tenue); }
  .barra { height: 4px; background: var(--linea); border-radius: 2px; overflow: hidden; }
  .barra span { display: block; height: 100%; background: var(--acento); transform: scaleX(var(--avance, 0)); transform-origin: left; transition: transform 0.4s; }

  .ficha { display: grid; grid-template-columns: 1fr 1fr; background: var(--vidrio); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); border: 1px solid var(--linea); border-radius: var(--r-3); }
  .ficha div { padding: 0.75rem 1rem; border-bottom: 1px solid var(--linea); }
  .ficha div:nth-child(odd) { border-right: 1px solid var(--linea); }
  .ficha div:nth-last-child(-n + 2) { border-bottom: 0; }
  .ficha dt { font-size: var(--t-0); color: var(--tenue); }
  .ficha dd { font-size: var(--t-1); font-weight: 500; margin-top: 0.15rem; }
  .ficha dd.dato { font-size: 1.05rem; }

  .reticula-grande { margin-top: 2.25rem; padding: 1.25rem; background: var(--vidrio); border: 1px solid var(--linea); border-radius: var(--r-3); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }

  .curso-cuerpo { display: grid; grid-template-columns: minmax(0, 1fr); gap: 3rem; padding-block: 2.5rem; }
  @media (min-width: 960px) { .curso-cuerpo { grid-template-columns: minmax(0, 1fr) 20rem; gap: 4rem; } }
  .temario h2, .lateral h2 { font-size: var(--t-4); margin-bottom: 1rem; }
  .lateral h2 { font-size: var(--t-3); }
  .unidades { border-top: 1px solid var(--linea); }
  details { border-bottom: 1px solid var(--linea); }
  summary {
    display: grid; grid-template-columns: 2.25rem 1fr auto; align-items: baseline; gap: 0.75rem;
    padding: 0.85rem 0.25rem; cursor: pointer; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover .u-t { color: var(--acento); }
  .u-n { color: var(--tenue); }
  .u-t { font-family: var(--f-titulo); font-size: 1.15rem; }
  .u-c { font-size: var(--t-0); color: var(--tenue); text-align: right; }
  details[open] summary .u-n { color: var(--acento); }
  .temas { list-style: none; padding: 0 0 1rem 0; }
  .temas li { display: grid; grid-template-columns: 2.75rem 1fr auto; gap: 0.75rem; align-items: baseline; padding: 0.45rem 0.25rem; border-top: 1px dashed var(--linea); }
  .t-n { color: var(--tenue); font-size: 0.8rem; }
  .t-t { color: var(--tinta-2); }
  .temas a { font-weight: 500; text-decoration: none; display: grid; }
  .temas a:hover { text-decoration: underline; }
  .t-tema { font-size: var(--t-0); color: var(--tenue); font-weight: 400; }
  .temas a.hecha::after { content: 'Completada'; font-size: var(--t-0); color: var(--acento); font-weight: 600; }
  @media (max-width: 520px) {
    .temas li { grid-template-columns: 2.5rem 1fr; }
    .temas .estado { grid-column: 2; }
    summary { grid-template-columns: 2rem 1fr; }
    .u-c { grid-column: 2; text-align: left; }
  }
  .complementarias { margin-top: 2rem; display: grid; gap: 0.6rem; }
  .complementarias h3 { font-size: var(--t-3); }
  .complementarias ul { list-style: none; display: grid; gap: 0.4rem; }

  .lateral { display: grid; gap: 2.25rem; align-content: start; }
  .lista-simple { list-style: none; display: grid; }
  .lista-simple li { display: grid; gap: 0.2rem; padding-block: 0.65rem; border-top: 1px solid var(--linea); font-size: var(--t-1); }
  .lista-simple .tenue { font-size: var(--t-0); }
  .descargas { display: flex; gap: 1rem; font-size: var(--t-0); font-weight: 600; }
</style>
