---
// Ediciones dictadas de los cursos del pub (docencia/contenido/dictados/*/dictado.yml).
import Base from '../../layouts/base.astro';
import { datos, plural } from '../../lib/datos.mjs';
const { pub, ediciones } = datos();
---
<Base titulo="Ediciones" descripcion={`Ediciones dictadas de los cursos de ${pub.nombre}.`} seccion="ediciones">
  <div class="envoltura pagina">
    <header>
      <h1>Ediciones</h1>
      <p>Cada edición es un dictado real de uno o más cursos de {pub.nombre}, con sus sesiones en orden y los materiales que se entregaron.</p>
    </header>
    {ediciones.length === 0 ? (
      <p class="tenue">Los cursos de este pub aún no tienen ediciones registradas.</p>
    ) : (
      <ul class="entradas">
        {ediciones.map((e) => (
          <li class="entrada">
            <span class="dato tenue">{e.periodo}</span>
            <div>
              <h2><a href={e.url}>{e.titulo}</a></h2>
              {e.descripcion && <p>{e.descripcion}</p>}
              <p class="metadatos">
                <span>{plural(e.sesiones.length, 'sesión', 'sesiones')}</span>
                <span>{plural(e.nMateriales, 'material', 'materiales')}</span>
                {e.cursos.length > 0 && <span>{e.cursos.map((c) => c.titulo).join(', ')}</span>}
              </p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
<style>
  .pagina { padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem); max-width: 60rem; }
  header { display: grid; gap: 0.75rem; margin-bottom: 2rem; }
  h1 { font-size: var(--t-5); }
  header p { color: var(--tinta-2); max-width: 60ch; }
  .entrada h2 { font-size: var(--t-3); }
  .entrada h2 a { text-decoration: none; }
</style>
