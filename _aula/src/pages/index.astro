---
// Inicio del pub: identidad, una lección real en curso, cursos destacados, ediciones y blog.
import Base from '../layouts/base.astro';
import LeccionEnCurso from '../components/leccion-en-curso.astro';
import TarjetaCurso from '../components/tarjeta-curso.astro';
import ListaEntradas from '../components/lista-entradas.astro';
import TarjetaEdicion from '../components/tarjeta-edicion.astro';
import Cifras from '../components/cifras.astro';
import Icono from '../components/icono.astro';
import { datos } from '../lib/datos.mjs';

const { pub, propios, destacados, blog, ediciones, enCurso } = datos();
const cursoDeEnCurso = enCurso?.origen === 'leccion' ? propios.find((c) => c.id === enCurso.item.curso) : null;
---
<Base seccion="inicio">
  <section class="portada">
    <div class="envoltura portada-rejilla">
      <div class="portada-texto">
        {pub.area && <p class="portada-area"><Icono nombre={pub.tono === 'tecnico' ? 'terminal' : 'graduation-cap'} tamano={15} />{pub.area.nombre}</p>}
        <h1>{pub.nombre}</h1>
        <p class="portada-lema">{pub.descripcion}</p>
        <div class="acciones">
          <a class="boton primario" href="/cursos/">Ver los cursos <Icono nombre="arrow-right" tamano={16} /></a>
          <button class="boton" type="button" data-abrir-paleta aria-haspopup="dialog"><Icono nombre="search" tamano={16} /> Buscar <kbd data-atajo>Ctrl K</kbd></button>
        </div>
      </div>
      <div class="portada-muestra">
        {enCurso ? <LeccionEnCurso enCurso={enCurso} cursoTitulo={cursoDeEnCurso?.titulo} /> : (
          <p class="tenue">Este pub aún no tiene lecciones ni artículos publicados.</p>
        )}
      </div>
    </div>
    <div class="envoltura portada-cifras"><Cifras /></div>
  </section>

  <section class="seccion envoltura" aria-labelledby="t-cursos">
    <div class="seccion-cabeza">
      <h2 id="t-cursos">Cursos</h2>
      <a href="/cursos/">Todos los cursos ({propios.length}) <Icono nombre="arrow-right" tamano={15} /></a>
    </div>
    <div class="rejilla-tarjetas">
      {destacados.map((c) => <TarjetaCurso curso={c} />)}
    </div>
  </section>

  {ediciones.length > 0 && (
    <section class="seccion envoltura" aria-labelledby="t-ediciones">
      <div class="seccion-cabeza">
        <h2 id="t-ediciones">Ediciones dictadas</h2>
        <p>Cada edición es un dictado real del curso, con sus sesiones y materiales.</p>
      </div>
      <ol class="rejilla-tarjetas">
        {ediciones.map((e) => <li><TarjetaEdicion ed={e} /></li>)}
      </ol>
    </section>
  )}

  <section class="seccion envoltura" aria-labelledby="t-blog">
    <div class="seccion-cabeza">
      <h2 id="t-blog">Del blog</h2>
      <a href="/blog/">Todas las entradas ({blog.length}) <Icono nombre="arrow-right" tamano={15} /></a>
    </div>
    <ListaEntradas entradas={blog.slice(0, 4)} />
  </section>
</Base>

<style>
  /* Portada: superficie lisa con un halo del acento y una trama de puntos casi imperceptible que se desvanece. */
  .portada { position: relative; overflow: clip; border-bottom: 1px solid var(--linea); padding-bottom: clamp(2rem, 1.5rem + 2vw, 3.25rem); background: var(--halo), var(--papel); }
  .portada::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; background: var(--puntos);
    -webkit-mask-image: radial-gradient(80% 70% at 50% 0%, black, transparent 75%); mask-image: radial-gradient(80% 70% at 50% 0%, black, transparent 75%);
  }
  .portada > .envoltura { position: relative; }
  .portada-rejilla { display: grid; gap: 2.75rem; padding-block: clamp(2.75rem, 1.75rem + 5vw, 5.5rem) clamp(2rem, 1.5rem + 2vw, 3rem); align-items: center; }
  @media (min-width: 1000px) { .portada-rejilla { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: 4.5rem; } }
  .portada-texto { display: grid; gap: 1.15rem; justify-items: start; }
  .portada-area {
    display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.3rem 0.7rem 0.3rem 0.55rem;
    font-size: var(--t-0); font-weight: 550; color: var(--tinta-2);
    background: var(--vidrio); border: 1px solid var(--linea); border-radius: 999px;
  }
  .portada-area :global(.icono) { color: var(--acento-tinta); }
  :global([data-tono='tecnico']) .portada-area { font-family: var(--f-datos); font-weight: 500; letter-spacing: -0.01em; }
  .portada h1 { font-size: var(--t-6); font-weight: 650; line-height: 1; letter-spacing: -0.045em; }
  /* Tono técnico (chaska, numerus-scriptum): un cursor de terminal tras el nombre que parpadea cuatro veces y se queda. */
  :global([data-tono='tecnico']) .portada h1::after {
    content: ''; display: inline-block; width: 0.09em; height: 0.78em; margin-left: 0.07em; vertical-align: -0.02em;
    background: var(--acento); border-radius: 1px; animation: cursor 1.1s steps(1) 4;
  }
  @keyframes cursor { 50% { opacity: 0; } }
  .portada-lema { font-size: clamp(1.1rem, 1rem + 0.45vw, 1.3rem); line-height: 1.5; color: var(--tinta-2); max-width: 34ch; }
  .portada-texto .acciones { margin-top: 0.4rem; }
  .portada-texto .acciones kbd { margin-left: 0.15rem; }
  .portada-muestra { min-width: 0; }
  .rejilla-tarjetas { list-style: none; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .seccion + .seccion { border-top: 1px solid var(--linea); }
</style>
