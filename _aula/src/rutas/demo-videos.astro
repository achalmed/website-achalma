---
// Página interna de demostración de los vídeos de divulgacion en una lección. NO es contenido publicado: solo existe con
// `astro dev` o al construir con AULA_DEMO=1, y lo dice en la propia página. Datos de muestra: src/demo/videos-ejemplo.json.
import Base from '../layouts/base.astro';
import Videos from '../components/videos.astro';
import { videosDelTema } from '../lib/videos.mjs';
import ejemplo from '../demo/videos-ejemplo.json';

export function getStaticPaths() {
  const activa = import.meta.env.DEV || process.env.AULA_DEMO === '1';
  return activa ? [{ params: { demo: 'demo' } }] : [];
}
const videos = videosDelTema(ejemplo.piezas, 'curso-ejemplo', '1.1');
---
<Base titulo="Componente de ejemplo: vídeos de la lección" descripcion="Página interna de demostración; no es contenido publicado.">
  <div class="envoltura demo">
    <p class="aviso" role="note"><b>Componente de ejemplo.</b> Esta página solo existe en desarrollo (o al construir con
      <code>AULA_DEMO=1</code>) para probar los vídeos de <code>divulgacion/catalogo.json</code> en una lección. Las piezas son de
      muestra: ninguna pertenece al canal. La tercera no tiene publicación con url y por eso no aparece.</p>
    <h1>Vídeos de la lección</h1>
    <Videos videos={videos} />
  </div>
</Base>
<style>
  .demo { padding-block: 2.5rem; max-width: 50rem; display: grid; gap: 1rem; }
  h1 { font-size: var(--t-5); }
  .aviso { padding: 0.9rem 1rem; border: 2px dashed var(--acento); border-radius: var(--r-2); background: var(--acento-suave); }
  code { font-family: var(--f-datos); font-size: 0.85em; }
</style>
